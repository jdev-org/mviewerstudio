# Configuration du serveur MCP MviewerStudio.
#
# Format :
# - une ligne KEY=VALUE par parametre ;
# - les lignes commencant par # sont des commentaires ;
# - les variables d'environnement deja presentes gardent la priorite ;
# - le chemin de ce fichier peut etre surcharge avec MVIEWERSTUDIO_MCP_CONFIG.


###############################################################################
# Transport MCP
###############################################################################

# Transport utilise au lancement CLI : stdio, streamable-http ou sse.
MCP_TRANSPORT=stdio

# Interface et port utilises pour les transports HTTP.
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8030

# true est recommande derriere certains clients MCP HTTP qui ne conservent pas
# l'en-tete mcp-session-id entre deux appels.
MVIEWERSTUDIO_MCP_STATELESS_HTTP=true


###############################################################################
# Logs MCP
###############################################################################

# Niveau de logs du processus MCP. Si non renseigne, LOG_LEVEL est utilise,
# puis INFO par defaut.
MVIEWERSTUDIO_MCP_LOG_LEVEL=INFO

# Fichier de logs rotatif du serveur MCP. Laisser vide pour desactiver le log
# fichier et garder uniquement la sortie console/systemd.
# En production, utiliser plutot un chemin systeme, par exemple :
# MVIEWERSTUDIO_MCP_LOG_FILE=/var/log/mviewerstudio/mcp_server.log
MVIEWERSTUDIO_MCP_LOG_FILE=logs/mcp_server.log

# Rotation du fichier de logs MCP.
MVIEWERSTUDIO_MCP_LOG_MAX_BYTES=10485760
MVIEWERSTUDIO_MCP_LOG_BACKUP_COUNT=5


###############################################################################
# URLs publiques et chemins mviewer
###############################################################################

# URL de MviewerStudio vue par le serveur MCP pour appeler l'API Flask.
MVIEWERSTUDIO_BASE_URL=http://localhost/mviewerstudio

# Recupere automatiquement les chemins mviewer et limites d'upload publies par
# l'API mviewerstudio /api/config/mcp. Garder true pour eviter de dupliquer la
# configuration backend dans ce fichier.
MVIEWERSTUDIO_MCP_USE_BACKEND_CONFIG=true
MVIEWERSTUDIO_MCP_BACKEND_CONFIG_TIMEOUT=0.5

# URL publique de mviewer utilisee pour construire les liens de brouillon.
MVIEWER_BASE_URL=http://localhost/mviewer/

# FQDN public de mviewer, sans chemin. Exemple : https://cartes.example.org
# Si renseigne, il est utilise comme origine navigateur par les tests CORS.
# Il peut aussi etre renseigne sans schema ; https:// sera alors suppose.
MVIEWER_FQDN=

# Origine navigateur explicite pour les tests CORS.
# Priorite superieure a MVIEWER_FQDN si renseignee.
MVIEWER_PUBLIC_ORIGIN=

# Chemins relatifs vus depuis mviewer pour les brouillons et publications.
# Si MVIEWERSTUDIO_MCP_USE_BACKEND_CONFIG=true et que l'API est joignable,
# ces valeurs sont reprises depuis CONF_PATH_FROM_MVIEWER et
# CONF_PUBLISH_PATH_FROM_MVIEWER cote backend.
# MVIEWER_CONF_PATH=apps/store/
# MVIEWER_PUBLIC_PATH=apps/public
MVIEWER_INSTANCE_PATH=/mviewer/

# Racine locale analysee par les outils de statistiques d'usage.
MVIEWER_APPS_ROOT=apps

# Repertoire local des addons mviewer. En developpement, le MCP tente de le
# retrouver automatiquement via le depot mviewer voisin. En production, le
# renseigner explicitement si les addons sont installes ailleurs.
# Exemple : /var/www/mviewer/addons
MVIEWER_ADDONS_PATH=

# Configuration frontend lue pour les fonds, fournisseurs OGC et valeurs par defaut.
MVIEWERSTUDIO_CONFIG_PATH=src/static/config.json


###############################################################################
# Identite et authentification
###############################################################################

# Identite serveur par defaut lorsque le MCP n'est pas derriere geOrchestra
# gateway ou un autre frontal qui fournit des en-tetes sec-*.
MCP_DEFAULT_USERNAME=ai
MCP_DEFAULT_ORG=my_org

# En mode heberge derriere geOrchestra gateway, activer la confiance dans les
# en-tetes sec-username, sec-firstname, sec-lastname, sec-org et sec-roles.
MVIEWERSTUDIO_MCP_TRUST_REQUEST_HEADERS=false

# A reserver au developpement local : autorise certains anciens appels d'outils
# a fournir directement une identite utilisateur.
MVIEWERSTUDIO_MCP_ALLOW_IDENTITY_OVERRIDE=false


###############################################################################
# Mode developpement et acces reseau OGC
###############################################################################

# Liste optionnelle d'hotes OGC supplementaires que le MCP peut contacter,
# separes par des virgules. Les fournisseurs declares dans config.json sont
# automatiquement autorises.
MVIEWERSTUDIO_MCP_ALLOWED_HOSTS=

# Mode developpement uniquement : autorise les appels vers des hotes non declares
# si aucun fournisseur OGC n'est configure.
MVIEWERSTUDIO_MCP_ALLOW_UNCONFIGURED_HOSTS=false

# Taille maximale, en octets, d'une donnee inline dans une URL data: de couche.
# Au-dela, le MCP refuse le XML et demande d'utiliser
# upload_spatial_file_to_mviewer_app pour stocker le GeoJSON/KML avec la carte.
# 0 interdit toute URL data:. Une valeur negative desactive cette limite.
MVIEWERSTUDIO_MCP_INLINE_DATA_MAX_BYTES=8192

# Taille maximale, en octets, d'un XML mviewer envoye par le MCP a l'API.
# Par defaut, la valeur est reprise depuis MVIEWERSTUDIO_XML_MAX_BYTES exposee
# par le backend. Decommenter uniquement pour une surcharge MCP locale.
# MVIEWERSTUDIO_MCP_XML_MAX_BYTES=1048576

# Taille maximale, en octets, d'un fichier spatial envoye par le MCP.
# Par defaut, la valeur est reprise depuis MVIEWERSTUDIO_SPATIAL_FILE_MAX_BYTES
# exposee par le backend. Decommenter uniquement pour une surcharge MCP locale.
# Une valeur negative desactive cette limite cote MCP, mais pas celle de l'API.
# MVIEWERSTUDIO_MCP_SPATIAL_FILE_MAX_BYTES=10485760

# Taille maximale, en octets, d'une page HTML d'aide/accueil envoyee par le MCP.
# Par defaut, la valeur est reprise depuis MVIEWERSTUDIO_HELP_FILE_MAX_BYTES
# exposee par le backend. Decommenter uniquement pour une surcharge MCP locale.
# MVIEWERSTUDIO_MCP_HELP_FILE_MAX_BYTES=262144
